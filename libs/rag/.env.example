# Never commit a real API key.
# Auto prefers OpenAI when both keys exist, otherwise it uses Gemini.
RAG_PROVIDER=auto

# Optional: uncomment this only when you have an OpenAI API key.
# OPENAI_API_KEY=your_openai_api_key_here

# Use this while OpenAI API access is unavailable.
GEMINI_API_KEY=your_gemini_api_key_here

# Optional model overrides. Defaults depend on the selected provider.
# OpenAI defaults: gpt-5.6-terra + text-embedding-3-large
# Gemini defaults: gemini-3.6-flash + gemini-embedding-2
# RAG_CHAT_MODEL=gemini-3.6-flash
# RAG_EMBEDDING_MODEL=gemini-embedding-2
RAG_REASONING_EFFORT=low
RAG_GEMINI_EMBEDDING_DIMENSIONS=768

# Local-only data.
RAG_INDEX_PATH=.rag/index.sqlite3
RAG_PDF_DIR=data/papers
RAG_TOP_K=6
RAG_CHUNK_WORDS=360
RAG_CHUNK_OVERLAP_WORDS=70
