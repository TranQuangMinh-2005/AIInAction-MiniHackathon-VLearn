# Choose one provider. Use "openai" for the paid demo key, or "gemini"
# when only a Gemini key is available. Changing provider requires re-indexing.
RAG_PROVIDER=gemini
GEMINI_API_KEY=your_gemini_api_key_here

# Paid OpenAI demo alternative:
# RAG_PROVIDER=openai
# OPENAI_API_KEY=your_openai_api_key_here

# Optional web-search upgrade; DuckDuckGo is the no-key fallback.
# TAVILY_API_KEY=your_tavily_api_key_here

# Optional model overrides. Defaults are selected per provider.
# RAG_CHAT_MODEL=gemini-3.6-flash
# RAG_EMBEDDING_MODEL=gemini-embedding-2
# OpenAI latency/cost-balanced default:
# RAG_CHAT_MODEL=gpt-5.6-terra
# RAG_EMBEDDING_MODEL=text-embedding-3-large
# Used automatically when the main Gemini model is rate-limited.
AGENT_GEMINI_FALLBACK_MODELS=gemini-3.1-flash-lite,gemini-2.5-flash-lite
RAG_GEMINI_EMBEDDING_DIMENSIONS=768

# Paths are resolved relative to codebase/rag by the integrated Agent.
RAG_INDEX_PATH=.rag/index.sqlite3
RAG_PDF_DIR=data/papers
RAG_TOP_K=6
